{
  "name": "max-chess-3d-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:migrate": "wrangler d1 migrations apply planetary-max-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:beemax": "vitest run --config vitest.beemax.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply planetary-max-db --local",
    "typecheck": "tsc --noEmit",
    "preview:worker": "wrangler dev --local --port 8787",
    "admin:setup": "node scripts/setup-admin.mjs"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "viem": "^2.58.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
